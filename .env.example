# Copier vers .env et remplir les valeurs (ne jamais committer .env)

# Clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude utilisé par l'agent (format LiteLLM)
MODEL_ID=anthropic/claude-sonnet-5

# URL du webhook entrant Microsoft Teams (Incoming Webhook du canal cible)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Nombre max d'étapes de raisonnement de l'agent (contrôle du coût)
AGENT_MAX_STEPS=15

# Recherche web — définir UNE de ces clés pour une recherche FIABLE.
# Sans clé, l'agent retombe sur DuckDuckGo (scraping), bloqué depuis la CI.
# Recommandé : Serper (https://serper.dev — Google, free tier généreux).
SERPER_API_KEY=
# Alternatives : Brave (https://brave.com/search/api/) ou Exa (https://exa.ai)
# BRAVE_API_KEY=
# EXA_API_KEY=
